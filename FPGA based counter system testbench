`timescale 1ns / 1ps

module counter_tb;

reg clk, rst;
wire [3:0] count;

counter_4bit dut (
    .clk(clk),
    .rst(rst),
    .count(count)
);

// Clock generation
initial begin
    clk = 0;
    forever #5 clk = ~clk;
end

// Stimulus
initial begin
    rst = 1;
    #10;
    rst = 0;

    #200;
    $finish;
end

endmodule
